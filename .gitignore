# Publish only the maintained library, tools and explicit example recipes.
# Existing tracked local files must also be removed from the Git index.
/*
!/.gitignore
!/.gitmodules
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/LICENSES/
/LICENSES/*
!/LICENSES/*.txt
!/pyproject.toml
!/requirements.txt
!/environment.yml
!/Makefile
!/MANIFEST.in
!/gmlab/
!/datasets/
/datasets/*
!/datasets/__init__.py
!/datasets/README.md
!/datasets/train/
/datasets/train/*
!/datasets/train/__init__.py
!/datasets/train/gl3d.py
!/datasets/train/u1652.py
!/datasets/valid/
/datasets/valid/*
!/datasets/valid/__init__.py
!/datasets/valid/gl3d.py
!/datasets/valid/u1652.py
!/datasets/valid/uav.py
!/scripts/
/scripts/*
!/scripts/README.md
!/scripts/_common.sh
!/scripts/train/
/scripts/train/*
!/scripts/train/run_training.sh
!/scripts/eval/
/scripts/eval/*
!/scripts/eval/evaluate_joint.sh
!/scripts/features/
/scripts/features/*
!/scripts/features/run_whitening_feature_extraction.sh
!/scripts/weights/
/scripts/weights/*
!/scripts/weights/fit_whitening.sh
!/scripts/retrieval/
/scripts/retrieval/*
!/scripts/retrieval/rank_cached_features.sh
!/scripts/retrieval/extract_and_build_pairs.sh
!/scripts/data/
/scripts/data/*
!/scripts/data/create_sues200_metadata.py
!/scripts/data/create_denseuav_metadata.py
!/scripts/data/sues200_official_split.json
!/tools/
/tools/*
!/tools/README.md
!/tools/environment/
!/tools/features/
!/tools/retrieval/
!/tools/weights/
!/assets/
/assets/*
!/assets/GeoMetricLab.png
!/assets/GeoMetricLab-banner.png
!/assets/supervision.svg
!/assets/metric_composition.svg
!/config/
/config/*
!/config/gmlab/
/config/gmlab/*
!/config/gmlab/README.md
!/config/gmlab/runtime.yaml
!/config/gmlab/metric/
/config/gmlab/metric/*
!/config/gmlab/metric/README.md
!/config/gmlab/metric/base.yaml
!/config/gmlab/metric/u1652_labels.yaml
!/config/gmlab/relation/
/config/gmlab/relation/*
!/config/gmlab/relation/README.md
!/config/gmlab/relation/base.yaml
!/config/gmlab/relation/gl3d_supscene_peft_dinov2_scpp.yaml
!/config/gmlab/relation/u1652_global_circleloss_a6k.yaml
!/config/gmlab/multimodal/
/config/gmlab/multimodal/*
!/config/gmlab/multimodal/README.md
!/config/gmlab/multimodal/base.yaml
!/config/gmlab/multimodal/u1652_multimodal.yaml
!/config/gmlab/joint/
/config/gmlab/joint/*
!/config/gmlab/joint/README.md
!/config/gmlab/joint/base.yaml
!/config/gmlab/joint/gl3d_u1652_joint.yaml
!/config/gmlab/joint/multisource_multimodal.yaml
!/config/extraction/
/config/extraction/*
!/config/extraction/base.yaml
!/config/extraction/peft_dinov2_scpp_gl3d_pretrain.yaml
!/config/extraction/gl3d_u1652_joint_pre_whitening.yaml
!/config/whitening/
/config/whitening/*
!/config/whitening/example.yaml
!/third_party/
/third_party/*
!/third_party/README.md
!/third_party/dinov2
!/third_party/dinov3
!/third_party/Depth-Anything-V2

# Generated files are never public, including below allowed source directories.
__pycache__/
*.py[cod]
*.egg-info/
*.ipynb
*.log
*.pth
*.pt
*.ckpt
*.h5
.env
.env.*

# Historical material and local research helpers are not release inputs.
/legacy/
/tools/pi3_overlap.py

# Local assets and development state (also covered by the root allowlist).
/data/
/weights/
/cache/
/.cache/
/results/
/checkpoints/
/logs/
/wandb/
/tests/
/notebooks/
/vis/
/.venv/
/.codex/
/AGENTS.md
