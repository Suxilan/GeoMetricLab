+  EncodedImage Encode(const QueryOptions& options,
+                       const FeatureKeypoints& keypoints,
+                       const FeatureDescriptorsFloat& descriptors) const override {
+    THROW_CHECK_EQ(descriptors.type, feature_type_);
+    EncodedImage encoded;
+    encoded.rows = descriptors.data.rows();
+    encoded.neighbors = options.num_neighbors;
+    if (encoded.rows == 0) return encoded;
+    const WordIds words = FindWordIds(descriptors.data, options.num_neighbors,
+                                      options.num_checks, options.num_threads);
+    encoded.words.assign(words.data(), words.data() + words.size());
+    inverted_index_.Encode(descriptors.data, words, &encoded.signatures);
+    if (!keypoints.empty()) {
+      THROW_CHECK_EQ(keypoints.size(), encoded.rows);
+      for (const auto& point : keypoints) {
+        FeatureGeometry geometry;
+        geometry.x = point.x;
+        geometry.y = point.y;
+        geometry.scale = point.ComputeScale();
+        geometry.orientation = point.ComputeOrientation();
+        encoded.geometry.push_back(geometry);
+      }
+    }
+    return encoded;
+  }
+
+  void AddEncoded(int image_id, const EncodedImage& encoded) override {
+    THROW_CHECK_EQ(encoded.neighbors, 1);
+    THROW_CHECK_EQ(encoded.geometry.size(), encoded.rows);
+    if (IsImageIndexed(image_id)) return;
+    image_ids_.insert(image_id);
+    prepared_ = false;
+    inverted_index_.AddEncoded(image_id, encoded.words, encoded.signatures, encoded.geometry);
+  }
+
+  void FinalizeQuery(EncodedImage* encoded) const override {
+    THROW_CHECK(prepared_);
+    encoded->normalization = inverted_index_.QueryNormalization(encoded->words);
+  }
+
+  void QueryEncoded(const QueryOptions& options, const EncodedImage& encoded,
+                     std::vector<ImageScore>* image_scores) const override {
+    THROW_CHECK(prepared_);
+    THROW_CHECK_LE(options.num_images_after_verification, 0);
+    inverted_index_.QueryEncoded(encoded.words, encoded.signatures,
+                                 encoded.normalization, image_scores);
+    FilterAndSort(options, image_scores);
+  }
