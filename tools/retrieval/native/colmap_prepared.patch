+  void Encode(const DescType& descriptors, const WordIds& words,
+              std::vector<uint64_t>* signatures) const {
+    signatures->resize(words.size());
+    for (Eigen::Index row = 0; row < words.rows(); ++row) {
+      const ProjDescType projected = proj_matrix_ * descriptors.row(row).transpose();
+      for (Eigen::Index col = 0; col < words.cols(); ++col) {
+        const auto word = words(row, col);
+        if (word == kInvalidWordId) continue;
+        std::bitset<kEmbeddingDim> binary;
+        inverted_files_.at(word).ConvertToBinaryDescriptor(projected, &binary);
+        (*signatures)[row * words.cols() + col] = binary.to_ullong();
+      }
+    }
+  }
+
+  void AddEncoded(int image_id, const std::vector<int64_t>& words,
+                  const std::vector<uint64_t>& signatures,
+                  const std::vector<FeatureGeometry>& geometry) {
+    THROW_CHECK_EQ(words.size(), geometry.size());
+    for (size_t row = 0; row < words.size(); ++row) {
+      if (words[row] == kInvalidWordId) continue;
+      EntryType entry;
+      entry.image_id = image_id;
+      entry.feature_idx = row;
+      entry.geometry = geometry[row];
+      entry.descriptor = std::bitset<kEmbeddingDim>(signatures[row]);
+      inverted_files_.at(words[row]).AddEncodedEntry(entry);
+    }
+  }
+
+  float QueryNormalization(const std::vector<int64_t>& words) const {
+    double similarity = 0.0;
+    for (auto word : words) {
+      if (word != kInvalidWordId) similarity += inverted_files_.at(word).SquaredIDFWeight();
+    }
+    return similarity > 0.0 ? 1.0f / std::sqrt(static_cast<float>(similarity)) : 1.0f;
+  }
+
+  void QueryEncoded(const std::vector<int64_t>& words,
