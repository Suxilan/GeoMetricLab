+                    std::vector<ImageScore>* image_scores) const {
+    image_scores->clear();
+    NodeHashMap<int, int> score_map;
+    std::vector<ImageScore> scores;
+    for (size_t i = 0; i < words.size(); ++i) {
+      if (words[i] == kInvalidWordId) continue;
+      inverted_files_.at(words[i]).ScoreEncodedFeature(
+          std::bitset<kEmbeddingDim>(signatures[i]), &scores);
+      for (const auto& score : scores) {
+        auto it = score_map.find(score.image_id);
+        if (it == score_map.end()) {
+          score_map.emplace(score.image_id, image_scores->size());
+          image_scores->push_back(score);
+        } else {
+          (*image_scores)[it->second].score += score.score;
+        }
+      }
+    }
+    for (auto& score : *image_scores) {
+      score.score *= normalization * normalization_constants_.at(score.image_id);
